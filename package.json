{
  "name": "airdelivery",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter \"*\" dev",
    "build": "bun run --filter \"*\" build",
    "start": "bun run --filter backend start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "bun run --filter \"@airdelivery/backend\" typecheck && bun run --filter \"@airdelivery/protocol\" typecheck",
    "test": "bun run --filter \"@airdelivery/protocol\" test && bun run --filter \"@airdelivery/backend\" test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage --coverage-reporter=lcov",
    "knip": "knip",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f signal",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "description": "Peer-to-peer file transfer over WebRTC. The signaling server never sees your files.",
  "license": "MIT",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.11"
  }
}
