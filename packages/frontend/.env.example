# ---------------------------------------------------------------------------
# AirDelivery environment. Copy to `.env` and fill in.
# Every variable is validated at startup — the process refuses to boot on a
# misconfiguration rather than half-working.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5500
LOG_LEVEL=info
# DEBUG=true enables verbose per-socket logging. Never enable in production:
# it is high volume and slows the event loop under load.

# --- Database (optional) -----------------------------------------------------
# The signaling server works without Mongo. Analytics and feedback need it.
# If it is unreachable the server still serves transfers and reports itself
# not-ready on /api/v1/ready.
# DB_URI=mongodb://localhost:27017/airdelivery

# --- CORS --------------------------------------------------------------------
# Comma-separated allowlist of browser origins.
# CORS_ORIGIN=https://airdelivery.site,http://localhost:3000

# --- Reverse proxy -----------------------------------------------------------
# MUST be set when running behind nginx / Fly / Railway / Cloudflare.
#
# Without it, express-rate-limit buckets every user under the proxy's single IP
# (so a "2 per 15 minutes" limit becomes two per quarter, globally), and
# x-forwarded-for is ignored, which breaks nearby-user discovery.
#
# TRUST_PROXY_HOPS=1 means "one proxy in front of me". Use the number of
# proxies that append to X-Forwarded-For.
# TRUST_PROXY_HOPS=1

# Only honour cf-connecting-ip / x-forwarded-for when a proxy is trusted.
# Leave false when exposed directly to the internet, or any client can spoof
# its address and poison the nearby-user buckets.
# TRUST_PROXY=false

# --- ICE / TURN --------------------------------------------------------------
# STUN alone works on most home networks. It does NOT work on a large share of
# campus and corporate networks, which is why TURN exists.
#
# Add a TURN relay or transfers will fail behind symmetric NAT. Free options:
#   - OpenRelay (https://www.openrelay.metered.ca) — free community tier
#   - Cloudflare Calls TURN — free tier available
#   - Self-hosted coturn (see docker-compose.override.example.yml)
#
# TURN credentials are handed to every browser that connects, so they are not
# secret in the way an API key is. Serve them from /api/v1/config so they can
# be rotated without rebuilding the frontend.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# --- Transfer tuning ---------------------------------------------------------
# Maximum bytes per WebRTC chunk. Chrome caps a single send() at 256 KB;
# raising this above that has no effect on Chromium.
# MAX_CHUNK_BYTES=262144
# Backpressure high-water mark. Higher fills the SCTP window more completely,
# which is faster, at the cost of memory.
# HIGH_WATER_MARK_BYTES=8388608
# Parallel partially-reliable data channels. More channels recover faster on a
# lossy mobile link because a lost packet does not stall the other channels.
# PARALLEL_CHANNELS=2

# --- Socket.IO ---------------------------------------------------------------
# Keep polling enabled. Forcing websocket-only means any proxy that strips the
# upgrade (common on corporate networks) cannot connect at all.
# SOCKET_TRANSPORTS=websocket,polling
# SOCKET_MAX_BUFFER_BYTES=262144
# SOCKET_PING_INTERVAL_MS=20000
# SOCKET_PING_TIMEOUT_MS=20000

# --- Rate limiting -----------------------------------------------------------
# Per-socket event budget, to stop one client starving the event loop.
# RATE_LIMIT_WINDOW_MS=10000
# RATE_LIMIT_MAX_EVENTS=300

# --- Shutdown ---------------------------------------------------------------
# How long to wait for a graceful shutdown before forcing the process down.
# Must be shorter than your orchestrator's kill timeout (30 s on Docker, 10 s
# on Kubernetes by default) or the SIGKILL wins and transfers are cut.
# SHUTDOWN_TIMEOUT_MS=10000
